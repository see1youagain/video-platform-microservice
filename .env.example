# Phase 4 安全配置模板
# 复制为 .env 后再启动 docker compose，或先 source 后配合 envsubst 渲染 K8s Secret。

# JWT
JWT_SECRET=replace-with-a-random-string-at-least-32-characters

# MinIO 服务端
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-root-password

# MinIO 客户端
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-strong-minio-secret-key

# K8s Secret 里也会引用这些变量
DB_PASSWORD=replace-with-db-password
REDIS_PASSWORD=
